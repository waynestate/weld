# Pinstripe owns the level and the ignore hygiene: level 8, every ignore
# needs a comment, and the banned calls (eval, dd(), TLS checks turned off,
# SQL joined from strings and the rest). It ships in require-dev, so the
# include below resolves wherever composer ci runs. Point at
# vendor/waynestate/pinstripe/phpstan/strict.neon instead to take the
# strict cut.
# Larastan registers itself through phpstan/extension-installer, so there is
# no Larastan include line to maintain here.
includes:
    - vendor/waynestate/pinstripe/phpstan/laravel.neon

parameters:
    # The application code. config/ is Laravel-generated boilerplate whose
    # env() calls trip level 8 (bool|string vs string), so it is out of scope,
    # the same way HELMET analyses src/ rather than the whole tree.
    paths:
        - app
        - bootstrap
        - routes
        - database
