{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "waynestate/weld",
    "type": "project",
    "description": "The Wayne State app stack, welded into one application.",
    "homepage": "https://weld.apps.wayne.edu/",
    "support": {
        "source": "https://github.com/waynestate/weld",
        "issues": "https://git.wayne.edu/enterprise-apps/weld/-/issues"
    },
    "keywords": [
        "laravel",
        "framework",
        "oracle"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/framework": "^13.29",
        "laravel/tinker": "^3.0",
        "tightenco/ziggy": "^2.4",
        "waynestate/helmet": "^1.3",
        "waynestate/sesame": "^0.7",
        "yajra/laravel-oci8": "^13.14"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.13",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.32",
        "laravel/sail": "^1.41",
        "league/commonmark": "^2.10",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpunit/phpunit": "^12.0",
        "waynestate/advisor": "^0.2",
        "waynestate/creed": "^0.1.8",
        "waynestate/pinstripe": "^0.3",
        "waynestate/proctor": "^0.11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "lint:gitlab": "pint --test --format=gitlab > pint-codequality.json",
        "fix": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "proctor": "proctor check",
        "ziggy": "php artisan ziggy:generate --types",
        "regen-check": "php bin/regen-check.php",
        "boost-update": "@php -r \"exit(is_dir('vendor/laravel/boost') && is_file('boost.json') && ! empty(json_decode(file_get_contents('boost.json'), true)['agents']) ? pclose(popen(escapeshellarg(PHP_BINARY) . ' artisan boost:update --ansi', 'w')) : 0);\"",
        "ci": [
            "@composer validate --strict",
            "@test",
            "@lint",
            "@analyse",
            "@site:agent-ready-check",
            "@docs:practices-check",
            "@docs:check",
            "@composer audit"
        ],
        "site:agent-ready": "php bin/agent-ready.php",
        "site:agent-ready-check": "php bin/agent-ready.php --check",
        "docs": "php bin/docs-site.php",
        "docs:check": "php bin/docs-site.php --check",
        "docs:practices": "php bin/sync-practices.php",
        "docs:practices-check": "php bin/sync-practices.php --check",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@boost-update"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ]
    },
    "scripts-descriptions": {
        "boost-update": "Refresh Laravel Boost's guidelines and skills (php artisan boost:update). Skipped when Boost is not set up here: no boost.json naming an agent yet, or a composer --no-dev install.",
        "regen-check": "Compare a freshly generated Sourdough Inertia app with WELD by SHA-256 and fail only on new drift versus .sourdough/regen-baseline.json. Pass --generated <dir> (and optionally --write-baseline) through.",
        "site:agent-ready": "Rewrite the Markdown twins, llms.txt, llms-full.txt, robots.txt and sitemap.xml in site/ (Squire's agent-ready kit).",
        "site:agent-ready-check": "Fail when the agent-ready files are stale, a page lacks its Markdown link, a prompt drifts from the docs, or the kit was edited here.",
        "docs": "Write site/docs/ from docs/ with the shared docs builder, and generate docs/changelog.md from CHANGELOG.md.",
        "docs:check": "Fail when the committed docs site is stale or the docs carry findings; writes nothing.",
        "docs:practices": "Rewrite the Practice, Why and Stack lines of every practice section in docs/guides from BEST_PRACTICES.md.",
        "docs:practices-check": "Fail when a guide's practice lines drift from BEST_PRACTICES.md; writes nothing.",
        "lint:gitlab": "Write Pint's findings as GitLab Code Quality JSON to pint-codequality.json ([] when clean), for the merge request widget."
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "proctor": {
            "wayneui.copies": "fail"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.3.0",
            "ext-oci8": "3.4.1"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
