APP_NAME=WELD
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Oracle: leave these empty if your app does not use Oracle; nothing connects until they are set. On Citadel, set them in the app's environment settings, never in a file in git.
# ORACLE_USERNAME=
# ORACLE_PASSWORD=
# ORACLE_TNS=
# ORACLE_HOST=
# ORACLE_PORT=
# ORACLE_SERVICE_NAME=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Which proxies Laravel trusts for X-Forwarded-Proto and the client address.
# Unset: 172.18.0.1, Citadel's proxy. Set but empty: trust none. `*`: trust every proxy (only where the
# proxy address is not known). Or a comma-separated list of IPs and CIDR ranges.
# Off Citadel set your own proxy here, and put the same list in HELMET_PROXIES below.
TRUSTED_PROXIES=172.18.0.1

# The address HA-Proxy connects from; the same list as trustProxies in
# bootstrap/app.php. Empty trusts nothing. A platform preset (citadel or
# docker) fills the list instead; when both are set, HELMET_PROXIES wins,
# and an unknown preset name throws at boot.
HELMET_PROXIES=172.18.0.1
# HELMET_PRESET=citadel

# SESAME owns sign-in. "fake" signs in locally without an identity provider
# and refuses to boot outside development environments; production sets
# SESAME_DRIVER=cas plus SESAME_CAS_BASE_URL.
SESAME_DRIVER=fake
SESAME_FAKE_USERNAME=jdoe
# SESAME_CAS_BASE_URL=
# SESAME_CAS_SERVICE_URL=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Queue worker (config/worker.php): "scheduler" on Citadel, where the
# scheduler starts a short queue:work each minute; "none" when a
# supervisor or a separate container runs the worker.
QUEUE_WORKER_MODE=scheduler

# How old the scheduler's heartbeat may be before /ready answers 503, in
# seconds (config/worker.php). The scheduler writes it each minute.
WORKER_HEARTBEAT_MAX_AGE=180
